# Copia este archivo como .env (ignorado por Git). NUNCA subas valores reales al repositorio.
#
# Públicas (pueden ir en el navegador; la seguridad la dan las políticas RLS de supabase/migrations):
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
#
# Privadas (solo en el servidor: Supabase Edge Functions / Cloudflare Workers / Vercel, como secretos):
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
SMTP_PASSWORD=
